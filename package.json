{
  "name": "vault-publisher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Builds an Obsidian vault as a static site with Quartz whenever a git-sync sidecar syncs a change, and persists the output for a Caddy sidecar to serve.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "start": "node dist/daemon.js"
  },
  "dependencies": {
    "@jackyzha0/quartz": "github:jackyzha0/quartz#v5"
  },
  "overrides": {
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
