{
  "name": "vault-publisher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Builds an Obsidian vault as a static site with Quartz whenever a git-sync sidecar syncs a change, and persists the output for a Caddy sidecar to serve.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "start": "node dist/daemon.js"
  },
  "dependencies": {
    "@jackyzha0/quartz": "github:jackyzha0/quartz#97a2d05f80c4c50534959b1d0d41cc4b3895625e"
  },
  "overrides": {
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
