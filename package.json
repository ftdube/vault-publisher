{
  "name": "vault-publisher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Polls an Obsidian vault git repo, builds it as a static site with Quartz, and persists the output for a Caddy sidecar to serve.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "start": "node dist/daemon.js"
  },
  "dependencies": {
    "@jackyzha0/quartz": "github:jackyzha0/quartz#v5"
  },
  "overrides": {
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
